<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules, API 31+ band (design §7.8, P10 option C).
     Secrets are never restored in any form; the legacy queue and the
     Room outbox are never restored either (their rows reference
     device-local state). Route metadata restore awaits the Stage D
     prefs split (routes currently share paylist.xml with the queue).
     Both sections (cloud backup AND device transfer) exclude the
     same files. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="paylist.xml" />
        <exclude domain="sharedpref" path="paylist_vault.xml" />
        <exclude domain="sharedpref" path="paylist_migration.xml" />
        <exclude domain="database" path="paylist-outbox.db" />
        <exclude domain="database" path="paylist-outbox.db-wal" />
        <exclude domain="database" path="paylist-outbox.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="paylist.xml" />
        <exclude domain="sharedpref" path="paylist_vault.xml" />
        <exclude domain="sharedpref" path="paylist_migration.xml" />
        <exclude domain="database" path="paylist-outbox.db" />
        <exclude domain="database" path="paylist-outbox.db-wal" />
        <exclude domain="database" path="paylist-outbox.db-shm" />
    </device-transfer>
</data-extraction-rules>
