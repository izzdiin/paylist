+            <script>
+            function paylistLogApp() {
+                return {
+                    rows: <?= json_encode($paylistJson, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>,
+                    csrfToken: <?= json_encode($csrfToken) ?>,
+                    q: '', fStatus: '', fApplied: '', page: 1, perPage: 15,
+                    initWatchers() {
+                        this.$watch('q', () => { this.page = 1; });
+                        this.$watch('fStatus', () => { this.page = 1; });
+                        this.$watch('fApplied', () => { this.page = 1; });
+                        this.$watch('perPage', () => { this.page = 1; });
+                    },
+                    get filtered() {
+                        const q = this.q.trim().toLowerCase();
+                        return this.rows.filter(r => {
+                            if (this.fStatus === 'belum-cocok') {
+                                // C3: matched + belum diterapkan (loser) juga perlu re-match.
+                                if (!(((r.match_status === 'logged' || r.match_status === 'ambiguous') || (r.match_status === 'matched' && !r.applied_at)) && r.amount !== null)) return false;
+                            } else if (this.fStatus && r.match_status !== this.fStatus) return false;
+                            if (this.fApplied === 'applied' && !r.applied_at) return false;
+                            if (this.fApplied === 'pending' && !(r.match_status === 'matched' && !r.applied_at)) return false;
+                            if (q) {
+                                const hay = (r.raw_text + ' ' + (r.amount === null ? '' : r.amount) + ' ' + (r.matched_id_pelanggan || '') + ' ' + (r.matched_id_payment || '') + ' ' + r.received_at).toLowerCase();
+                                if (!hay.includes(q)) return false;
+                            }
+                            return true;
+                        });
+                    },
+                    get totalPages() { return Math.max(1, Math.ceil(this.filtered.length / this.perPage)); },
+                    get pageSafe() { return Math.min(this.page, this.totalPages); },
+                    get paged() { const st = (this.pageSafe - 1) * this.perPage; return this.filtered.slice(st, st + this.perPage); },
+                    get startNum() { return this.filtered.length ? (this.pageSafe - 1) * this.perPage + 1 : 0; },
+                    get endNum() { return Math.min(this.filtered.length, this.pageSafe * this.perPage); },
+                    get pageList() {
+                        const total = this.totalPages, cur = this.pageSafe, out = [];
+                        let a = Math.max(1, cur - 2), b = Math.min(total, cur + 2);
+                        if (b - a < 4) { a = Math.max(1, b - 4); b = Math.min(total, a + 4); }
+                        for (let n = a; n <= b; n++) out.push(n);
+                        return out;
+                    },
+                    fmtRp(n) { return (n === null || n === undefined) ? '-' : 'Rp' + Number(n).toLocaleString('id-ID'); },
+                    badgeClass(st) { return st === 'matched' ? 'bg-green-100 text-green-800' : (st === 'ambiguous' ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-700'); },
+                    pelangganText(r) { if (!r.matched_id_pelanggan) return '-'; return r.matched_id_pelanggan + (r.matched_id_payment ? ' / ' + r.matched_id_payment : ''); },
+                    appliedText(r) { if (r.applied_at) return 'Diterapkan ' + r.applied_at; if (r.match_status === 'matched') return 'Belum diterapkan'; return '-'; },
+                    rematchText(r) { return 'Cocok ulang ' + r.rematch_count + '× oleh ' + (r.rematched_by || '?') + (r.last_rematch_at ? ' (' + r.last_rematch_at + ')' : ''); },
+                    canRematch(r) { return (r.match_status === 'logged' || r.match_status === 'ambiguous' || r.match_status === 'matched') && !r.applied_at && r.amount !== null; },
+                    rematch(r) {
+                        if (!this.canRematch(r)) return;
+                        if (!confirm('Cocokkan ulang pembayaran Rp' + Number(r.amount).toLocaleString('id-ID') + ' ini? Bila cocok, tagihan langsung dilunasi.')) return;
+                        r._rematching = true; r._rematchMsg = '';
+                        const fd = new FormData();
+                        fd.append('log_id', r.id);
+                        fd.append('csrf_token', this.csrfToken);
+                        fetch('../paylist/paylist_rematch.php', { method: 'POST', body: fd, credentials: 'same-origin' })
+                            .then(res => res.json().then(j => ({ status: res.status, body: j })).catch(() => ({ status: res.status, body: null })))
+                            .then(({ status, body }) => {
+                                r._rematching = false;
+                                if (!body || body.ok !== true) {
+                                    r._rematchMsg = 'Gagal (' + status + '): ' + ((body && (body.error || body.note)) || 'respons tidak terbaca');
+                                    return;
+                                }
+                                r.match_status = body.after;
+                                if (body.id_pelanggan) r.matched_id_pelanggan = body.id_pelanggan;
+                                if (body.payment) r.matched_id_payment = body.payment;
+                                if (body.applied_at !== undefined) r.applied_at = body.applied_at;
+                                if (body.apply_note !== undefined) r.apply_note = body.apply_note;
+                                if (body.rematch_count !== undefined) r.rematch_count = body.rematch_count;
+                                if (body.last_rematch_at !== undefined) r.last_rematch_at = body.last_rematch_at;
+                                if (body.rematched_by !== undefined) r.rematched_by = body.rematched_by;
+                                r._rematchMsg = body.note || ('Status: ' + body.after);
+                            })
+                            .catch(err => { r._rematching = false; r._rematchMsg = 'Gagal: ' + err.message; });
+                    }
+                };
+            }
