+// Revalidasi binding di bawah kunci (perbaikan C2 review #8, P1 stale
+// match binding, 24 Nov 2026). Dipakai BERSAMA oleh
+// paylist_apply_payment dan paylist_apply_topup, sebagai pernyataan
+// pertama di DALAM transaksi apply (sesudah begin_transaction).
+//
+// Kunci baris log DULU — ini juga perbaikan C2 review #7 (temuan lomba
+// F2-hookrace 24 Nov 2026): apply sebelumnya membaca baris log tanpa
+// kunci lalu baru menulisnya di akhir transaksi; bila aktor re-match
+// mengubah baris yang sama di tengah jalan (stempel rematch_count),
+// MariaDB membatalkan SELURUH transaksi dengan ER_CHECKREAD (1020)
+// "Record has changed since last read". Dengan kunci FOR UPDATE sejak
+// awal, tidak ada modifikasi antar-sela yang mungkin, dan penjaga
+// diperiksa ulang di bawah kunci.
+//
+// Urutan kunci: baris log dulu (FOR UPDATE), lalu baris payment
+// (FOR UPDATE) — seragam di semua entrypoint; tidak ada entrypoint yang
+// mengunci tagihan dulu lalu log, jadi tidak ada siklus deadlock baru.
+//
+// Membandingkan binding SEGAR dari baris log (matched_id_payment,
+// matched_id_pelanggan, amount) dengan pilihan SELEKSI pemanggil (yang
+// dibaca sebelum transaksi); lalu mengunci baris payment segar dan
+// memeriksa status, pelanggan, dan nominal harapan (rumus matcher).
+// Tanpa ini, apply mengklaim payment BASI: klaim atomik hanya gagal bila
+// tagihan lama sudah PAID; bila masih UNPAID, tagihan yang SALAH ikut
+// lunas (celah yang ditunjukkan re-review #8 atas klaim "known-safe
+// edge" §13.5 desain).
+//
+// Kegagalan PENJAGA (log hilang / sudah tidak matched / sudah
+// diterapkan) MELEMPAR seperti sebelumnya — pemanggil me-rollback tanpa
+// menulis catatan (catatan di baris yang sudah diterapkan akan menimpa
+// catatan sukses). Penolakan BINDING BASI dikembalikan sebagai string
+// alasan (dan mengisi $paySegar dengan baris payment segar bila ada);
+// pemanggil menulis catatan penolakan di apply_note + commit, lalu
+// keluar tanpa efek bisnis lain. Mengembalikan NULL bila valid.
+function paylist_revalidate_binding(mysqli $db, $logId, $selPayId, $selPelanggan, $selAmount, &$paySegar) {
+    $paySegar = null;
+    $lock = $db->prepare("SELECT amount, match_status, matched_id_pelanggan, matched_id_payment, applied_at FROM paylist_log WHERE id = ? FOR UPDATE");
+    $lock->bind_param('i', $logId);
+    $lock->execute();
+    $logKunci = $lock->get_result()->fetch_assoc();
+    $lock->close();
+    if (!$logKunci) { throw new Exception('log tidak ditemukan (di bawah kunci)'); }
+    if ($logKunci['match_status'] !== 'matched' || !empty($logKunci['applied_at'])) {
+        throw new Exception('log sudah tidak matched / sudah diterapkan oleh proses lain');
+    }
+    $segarPay = (int)$logKunci['matched_id_payment'];
+    $segarPelanggan = (string)$logKunci['matched_id_pelanggan'];
+    $segarAmount = (int)$logKunci['amount'];
+    if ($segarPay !== (int)$selPayId || $segarPelanggan !== (string)$selPelanggan
+        || ($selAmount !== null && $segarAmount !== (int)$selAmount)) {
+        return 'pilihan payment ' . $selPayId . ' (pelanggan ' . $selPelanggan . ', Rp ' . $selAmount . ') tidak lagi cocok dengan log (payment ' . $segarPay . ', pelanggan ' . $segarPelanggan . ', Rp ' . $segarAmount . ')';
+    }
+    $pf = $db->prepare("SELECT id, idtrx, id_pelanggan, nama_pelanggan, layanan, tagihan, nama_mitra, kode_unik, status FROM payment WHERE id = ? FOR UPDATE");
+    $pf->bind_param('i', $segarPay);
+    $pf->execute();
+    $paySegar = $pf->get_result()->fetch_assoc();
+    $pf->close();
+    if (!$paySegar) { return 'payment ' . $segarPay . ' tidak ditemukan (di bawah kunci)'; }
+    if ($paySegar['status'] === 'PAID') { return 'payment ' . $segarPay . ' sudah PAID'; }
+    if ((string)$paySegar['id_pelanggan'] !== $segarPelanggan) {
+        return 'payment ' . $segarPay . ' milik ' . $paySegar['id_pelanggan'] . ', bukan ' . $segarPelanggan;
+    }
+    if ($paySegar['kode_unik'] === null) { return 'payment ' . $segarPay . ' belum berkode unik'; }
+    if (!function_exists('paylist_expected_nominal')) {
+        require_once __DIR__ . '/paylist_match.php';
+    }
+    $nominalHarapan = paylist_expected_nominal($paySegar['tagihan'], (int)$paySegar['kode_unik']);
+    if ($nominalHarapan !== $segarAmount) {
+        return 'nominal harapan payment ' . $segarPay . ' (Rp ' . $nominalHarapan . ') tidak sama dengan amount log (Rp ' . $segarAmount . ')';
+    }
+    return null;
+}
